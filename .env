PGHOST=localhost          # или IP сервера
PGPORT=5432               # порт вашей базы
PGUSER=devuser           # пользователь
PGPASSWORD=devpass         # пароль
PGDATABASE=messenger         # название базы


NEXT_PUBLIC_WS_URL=http://localhost:4000


# This was inserted by `prisma init`:
